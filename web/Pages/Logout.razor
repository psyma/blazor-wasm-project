@page "/Logout" 
@using web.Services.Auth
@using web.Services.JwtState

@inject IAuthService AuthService
@inject JwtAuthStateProvider JwtAuthStateProvider
@inject NavigationManager NavigationManager

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await JwtAuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        await AuthService.Logout(user.Identity?.Name);
        
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}